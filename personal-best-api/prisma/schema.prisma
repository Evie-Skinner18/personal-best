// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TrainingModality {
  Karate
  Calisthenics
  BJJ
  Weights
  Movement
  Running
}

enum MeasurementUnit {
  minutes
  reps
}

model Exercise {
  id                    String           @id @default(uuid()) @db.Uuid
  name                  String           @db.VarChar(255)
  currentPersonalBestId String?          @map("current_personal_best_id") @db.Uuid
  modality              TrainingModality
  dateLastTrained       DateTime?        @map("date_last_trained")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  // Relations
  // to-do do we need the Attempts[] array
  attempts              Attempt[]
  currentPersonalBest   Attempt?         @relation("CurrentPersonalBest", fields: [currentPersonalBestId], references: [id])

  @@index([modality])
  @@index([name])
  @@map("exercises")
}

model Attempt {
  id              String          @id @default(uuid()) @db.Uuid
  exerciseId      String          @map("exercise_id") @db.Uuid
  date            DateTime
  measurementUnit MeasurementUnit @map("measurement_unit")
  number          Int             @default(0)
  weight          Int?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // Relations
  exercise                      Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  // to-do not sure what this is doing
  exerciseAsCurrentPersonalBest Exercise[] @relation("CurrentPersonalBest")

  @@index([exerciseId])
  @@index([date])
  @@map("attempts")
}