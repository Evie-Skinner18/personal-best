// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TrainingModality {
  Karate
  Calisthenics
  BJJ
  Weights
  Movement
  Running
}

enum MeasurementUnit {
  minutes
  reps
}

model Exercise {
  id                    String           @id @default(uuid()) @db.Uuid
  name                  String           @db.VarChar(255)
  currentPersonalBestId String?          @map("current_personal_best_id") @db.Uuid
  modality              TrainingModality
  dateLastTrained       DateTime?        @map("date_last_trained")
  measurementUnit       MeasurementUnit @map("measurement_unit")

  // Relations
  currentPersonalBest   Attempt?         @relation("CurrentPersonalBest", fields: [currentPersonalBestId], references: [id])

  @@index([modality])
  @@index([name])
  @@map("exercises")
}

model Attempt {
  id              String          @id @default(uuid()) @db.Uuid
  exerciseId      String          @map("exercise_id") @db.Uuid
  date            DateTime
  numberOfReps    Int?            
  timeInMinutes   Int?
  weightInKg      Int             @default(0)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // Relations
  exercise                      Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
  @@index([date])
  @@map("attempts")
}

model PersonalBestAggregate {
    id              String          @id @default(uuid()) @db.Uuid
    attemptId       String          @map("attempt_id") @db.Uuid
    exerciseId      String          @map("exercise_id") @db.Uuid
    exerciseName    String          @map("exercise_name") @db.VarChar(255)
    measurementUnit MeasurementUnit @map("measurement_unit")
    numberOfReps    Int? 
    timeInMinutes   Int?
    weightInKg      Int             @default(0)
    date            DateTime
    amountAboveLastPb Int           @default(0)

    // Relations
    exercise        Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
    attempt         Attempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}